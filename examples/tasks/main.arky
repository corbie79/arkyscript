--!typecheck strict
import task from "task"

-- Two reusable OS threads; at most 128 waiting tasks.
task.configure(2, 128)

-- No captured variables: pass all input explicitly. Each invocation gets its
-- own Lua VM and a copied input tree. Context is supplied by the task runtime.
local function sum(input: any, context: any): any
   local total = 0
   for i = 1, input.limit do
      if i % 1024 == 0 then
         context.checkpoint()
      end
      total = total + i
   end
   input.total = total
   return input
end

local data = {limit = 10000}
local first = task.spawn(sum, data)
local second = task.spawn(sum, {limit = 20000})
data.limit = 1 -- already submitted input is unaffected

-- Work already runs on the pool. wait() blocks only this calling thread.
local a = first:wait()
local b = second:wait()
print("Parallel task sum: " .. tostring(a.total + b.total))
print("Input isolation: " .. tostring(data.limit) .. " / " .. tostring(a.limit))
print("Task status: " .. first:status())
task.shutdown()
