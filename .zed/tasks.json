[
  {
    "label": "Arky: check example",
    "command": "cargo",
    "args": [
      "run",
      "--quiet",
      "--locked",
      "-p",
      "tynex-cli",
      "--",
      "check",
      "examples/main.arky"
    ],
    "cwd": "$ZED_WORKTREE_ROOT",
    "save": "all"
  },
  {
    "label": "Arky: run example",
    "command": "cargo",
    "args": [
      "run",
      "--quiet",
      "--locked",
      "-p",
      "tynex-cli",
      "--",
      "run",
      "examples/main.arky"
    ],
    "cwd": "$ZED_WORKTREE_ROOT",
    "save": "all"
  },
  {
    "label": "Arky: start example for EmmyLua",
    "command": "cargo",
    "args": [
      "run",
      "--quiet",
      "--locked",
      "-p",
      "tynex-cli",
      "--",
      "debug",
      "examples/main.arky"
    ],
    "cwd": "$ZED_WORKTREE_ROOT",
    "save": "all",
    "use_new_terminal": true,
    "allow_concurrent_runs": false
  },
  {
    "label": "Arky: prepare debug bundle",
    "command": "cargo",
    "args": [
      "run",
      "--quiet",
      "--locked",
      "-p",
      "tynex-cli",
      "--",
      "bundle",
      "examples/debug/main.arky",
      "--out",
      "build/debug/modules"
    ],
    "cwd": "$ZED_WORKTREE_ROOT",
    "save": "all"
  },
  {
    "label": "Arky: start mapped bundle for EmmyLua",
    "command": "cargo",
    "args": [
      "run",
      "--quiet",
      "--locked",
      "-p",
      "tynex-cli",
      "--",
      "exec-bundle",
      "build/debug/modules",
      "--debug"
    ],
    "cwd": "$ZED_WORKTREE_ROOT",
    "use_new_terminal": true,
    "allow_concurrent_runs": false
  }
]
